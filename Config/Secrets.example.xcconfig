// Copy this file to Config/Secrets.xcconfig and replace the placeholder.
// Secrets.xcconfig is git-ignored — never commit your real token.
//
// Use a PUBLIC token (starts with "pk.") from https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN = YOUR_MAPBOX_ACCESS_TOKEN

// Optional: reverse-DNS prefix for the bundle identifier (needed for device builds).
// TOPONAV_BUNDLE_ID_PREFIX_OVERRIDE = com.yourname
